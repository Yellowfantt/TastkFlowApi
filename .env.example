# TaskFlow API - exemplo de variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores conforme necessário.
# O arquivo .env NÃO deve ser commitado (está no .gitignore).

# Ambiente: development | production
APP_ENV=development

# Caminho do banco SQLite (relativo ao diretório do projeto).
# Em produção, considere um caminho absoluto ou outro banco (Postgres).
DATABASE_URL=sqlite:///./taskflow.db

# Host e porta do servidor ASGI (informativos; o comando real fica em run.py / uvicorn).
APP_HOST=127.0.0.1
APP_PORT=8000
